# Environment for `cadastre-mcp-remote`. The bridge speaks stdio locally and
# forwards every tool call to the standard Streamable HTTP `/mcp` endpoint.
CADASTRE_MCP_URL=https://cadastre.example.invalid/mcp
CADASTRE_REMOTE_ONLY=1
# Operator-managed file; do not commit it or put its value in a URL/argument.
CADASTRE_HTTP_TOKEN_FILE=/run/secrets/cadastre-http-token
