# Sample /etc/cadastre/collect.env. Copy, fill in, chmod 0400, chown cadastre.
#
# One read-only credential per plugin, matching the `token_env` names in
# declared/plugins.yaml. Read-only is not advice: if the catalog host is
# compromised the blast radius should be "someone learned your topology", not
# "someone changed your DNS" (README §Security posture).
#
# NEVER commit the filled-in copy. This file is the only place on the collector
# host where a credential exists; the catalog itself holds references only.

# Forge, self-hosted — repo read
CADASTRE_P_FORGE_TOKEN=

# Forge, public — repo:read, the mirror side
CADASTRE_P_GITHUB_TOKEN=

# Forge, public — self-hosted runner inventory. A separate, narrower credential
# from the repo token above: organisation `Self-hosted runners: read` and
# nothing else. It reads registrations; it cannot create a registration or
# removal token, and it must never be one that can.
CADASTRE_P_GITHUB_RUNNERS_TOKEN=

# Forge, public — workflow inventory, and the optional selector/job-history
# sections. Repository `Actions: read`, plus `Contents: read` only if
# `workflow_selectors` is enabled. Separate from the two above so each source
# fails independently and no one token carries every scope.
CADASTRE_P_GITHUB_WORKFLOWS_TOKEN=

# CI — pipeline read
CADASTRE_P_CI_TOKEN=

# Secret manager — list/name access only. If the token can read values, it is
# the wrong token: the plugin refuses loudly when a value reaches its output.
CADASTRE_P_SECRETS_TOKEN=

# DNS — Zone:Read on the zones in `zones`. This is the credential to scope most
# carefully.
# Do NOT reuse an ACME/DNS-01 token here: those carry Zone:Edit, and a
# collector that can mutate DNS is a different risk from one that can read it.
CADASTRE_P_DNS_TOKEN=

# VPN — device read. Retrieve the value from your secret manager on the
# collector host and inject it here at runtime.
# It must be an API token or OAuth client with `devices:core:read`.
# NOT a `tskey-auth-…` join key: that adds a node, it cannot enumerate them.
CADASTRE_P_VPN_TOKEN=

# Hypervisor — PVEAuditor role, nothing wider
CADASTRE_P_PVE_TOKEN=
