# Agent-runtime configuration.
#
# The agent runtime is a client, not a Cadastre catalog host. Do not set
# CADASTRE_CATALOG here. A native remote MCP client should be configured with
# the `/mcp` URL directly. The Cadastre bridge uses CADASTRE_MCP_URL.
CADASTRE_MCP_URL=https://cadastre.internal.example/mcp
# The ordinary HTTP/API base URL is separate and is used only by HTTP clients
# or the MCP server's configured backend path.
CADASTRE_HTTP_URL=https://cadastre.internal.example
CADASTRE_REMOTE_ONLY=1
# Fallback only: this token is available to the MCP process. Prefer workload
# identity or an authenticated sidecar/proxy so the agent does not hold a
# reusable bearer credential. Its contents are never put in argv, URLs, or the
# catalog.
CADASTRE_HTTP_TOKEN_FILE=/run/secrets/cadastre-http-token
