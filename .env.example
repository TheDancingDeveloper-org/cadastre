# Cadastre — deployment configuration.
#
# Copy to `.env` beside `compose.production.yaml` and edit. Every variable
# below is substituted into that file; `docker compose` reads `.env` from the
# working directory automatically, and a scheduled run must name it explicitly
# (`--env-file /srv/cadastre/.env` — see DEPLOYMENT.md §8).
#
# This file configures the *server* deployment. The agent-side client is
# configured separately: see `examples/agent-runtime.env.sample`.
#
# IMPORTANT: this file holds no credentials. Plugin credentials live in the
# collector environment file — see CADASTRE_COLLECT_ENV_FILE at the bottom and
# `examples/collector/collect.env.sample`. Compose substitution variables are
# not container environment; putting a token here does not deliver it to any
# plugin.

# ---------------------------------------------------------------------------
# Images — REQUIRED. The shipped defaults are placeholders and will not pull.
# ---------------------------------------------------------------------------

# Pin by signed digest, not a tag.
CADASTRE_IMAGE=ghcr.io/example/cadastre@sha256:REPLACE_WITH_SIGNED_DIGEST

# Only needed for the `direct-https` and `direct-mcp` profiles, which run the GUI.
CADASTRE_GUI_IMAGE=ghcr.io/example/cadastre-gui@sha256:REPLACE_WITH_SIGNED_DIGEST

# ---------------------------------------------------------------------------
# Published ports and bind address
# ---------------------------------------------------------------------------

# The interface published ports bind to. Keep it loopback unless a proxy or
# tailnet address is deliberately terminating traffic (DEPLOYMENT.md §5).
CADASTRE_BIND_IP=127.0.0.1

# `local` profile — plain HTTP, loopback development only.
CADASTRE_LOCAL_PORT=8000

# `direct-https` profile — the HTTP/API front door.
CADASTRE_API_PORT=8443

# `direct-mcp` profile — the MCP endpoint. Distinct from the API port.
CADASTRE_MCP_PORT=8444

# GUI static host.
CADASTRE_GUI_PORT=8080

# Origin the GUI calls the API on, as the browser resolves it. Must match the
# TLS certificate and the published API port, not the container-internal one.
CADASTRE_API_ORIGIN=https://localhost:8443

# ---------------------------------------------------------------------------
# Host directories bind-mounted read-only into the containers
#
# Each must exist before `docker compose up`; a missing path becomes an empty
# mount, not an error.
# ---------------------------------------------------------------------------

# `tls.crt` and `tls.key` for the `direct-https` and `direct-mcp` profiles.
CADASTRE_TLS_DIR=/etc/cadastre/tls

# `tokens` — the bearer token file backing --require-auth.
CADASTRE_AUTH_DIR=/etc/cadastre/auth

# `secret` — the shared secret for the `proxy` profile.
CADASTRE_PROXY_DIR=/etc/cadastre/proxy

# Plugin configuration (`declared/plugins.yaml`) for the collector. Load-bearing:
# this is what names every source and its `token_env`. If it resolves to an
# empty directory the collector runs, collects nothing, and still exits 0.
CADASTRE_COLLECT_CONFIG_DIR=/etc/cadastre/collect

# `client_id` and `client_secret` for the Infisical universal-auth login used by
# `secrets-infisical` sources. Only needed if such a source is configured.
CADASTRE_INFISICAL_DIR=/etc/cadastre/infisical

# ---------------------------------------------------------------------------
# Trusted-proxy profile
# ---------------------------------------------------------------------------

# CIDR the proxy is trusted to forward from.
CADASTRE_PROXY_NETWORK=10.0.0.0/8

# Principal-to-scope mapping the proxy may assert.
CADASTRE_PROXY_SCOPE=proxy=catalog.read

# ---------------------------------------------------------------------------
# Collector credentials
# ---------------------------------------------------------------------------

# Environment file delivering one read-only `CADASTRE_P_*` credential per
# configured plugin, matching the `token_env` names in `declared/plugins.yaml`.
# Copy `examples/collector/collect.env.sample`, fill it in, `chmod 0400`.
#
# Optional: an estate whose sources are all `secrets-infisical` does not need
# it, because those tokens are minted in-process by the entrypoint. Every other
# plugin — forge, CI, DNS, VPN, hypervisor — reads its credential from this
# file and collects nothing without it.
CADASTRE_COLLECT_ENV_FILE=/etc/cadastre/collect.env

# Name of the variable the minted Infisical access token is placed in. Must
# match the `token_env` of the `secrets-infisical` source in
# `declared/plugins.yaml`. Comma-separate if several sources share one login.
CADASTRE_INFISICAL_TOKEN_ENV=CADASTRE_P_SECRETS_TOKEN

# ---------------------------------------------------------------------------
# Docker object names
# ---------------------------------------------------------------------------

# Named volume holding catalog.sqlite3 and observed.sqlite3. Renaming this on a
# running deployment points the stack at an empty database; see DEPLOYMENT.md §7.
CADASTRE_VOLUME=cadastre-data

CADASTRE_NETWORK=cadastre
